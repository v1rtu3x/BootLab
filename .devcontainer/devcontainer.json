{
  "name": "BootLab Lab",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/BootLab,type=bind,consistency=cached",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "rust-lang.rust-analyzer",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/bootlab/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestPath": "/opt/bootlab/.venv/bin/pytest",
        "python.testing.pytestArgs": ["-v"]
      }
    }
  },
  "containerEnv": {
    "PYTHONPATH": "/workspaces/BootLab/src"
  },
  "workspaceFolder": "/workspaces/BootLab",
  "postCreateCommand": "./scripts/apply-mcuboot-patches.sh && bootlab build-corpus && bootlab validate-scenarios",
  "remoteUser": "root"
}
