+// Copyright (c) 2026 BootLab contributors
+//
+// SPDX-License-Identifier: Apache-2.0
+
+//! Direct BootLab image-input integration. Images are read from immutable
+//! corpus paths supplied by the Python adapter and installed into MCUboot's
+//! simulator flash layout.
+
+use bootsim::{testlog, DeviceName, ImagesBuilder};
+
+#[test]
+fn bootlab_direct_image() {
+    testlog::setup();
+    let primary_path = std::env::var("BOOTLAB_PRIMARY_IMAGE")
+        .expect("BOOTLAB_PRIMARY_IMAGE is required");
+    let candidate_path = std::env::var("BOOTLAB_CANDIDATE_IMAGE")
+        .expect("BOOTLAB_CANDIDATE_IMAGE is required");
+    let primary = std::fs::read(&primary_path).expect("could not read primary image input");
+    let candidate = std::fs::read(&candidate_path).expect("could not read candidate image input");
+    let fault_index = std::env::var("BOOTLAB_FAULT_INDEX")
+        .ok().map(|value| value.parse::<i32>().expect("fault index must be an integer"));
+    let builder = ImagesBuilder::new(DeviceName::Nrf52840, 8, 0xff)
+        .expect("reference nrf52840 layout must be supported");
+    let observation = builder.run_bootlab_direct(&primary, &candidate, fault_index)
+        .expect("direct bootloader run must return a structured observation");
+    println!("{}", observation);
+}
