+    pub fn run_fault_campaign_observation(&self, fault_index: i32) -> FaultCampaignObservation {
+        let (flash, operation_count, interruption_reached) = self.try_upgrade_observed(Some(fault_index), true);
+        let primary_image_valid = self.verify_images(&flash, 0, 1);
+        let secondary_image_valid = !self.is_swap_upgrade() || self.verify_images(&flash, 1, 0);
+        let primary_trailer_valid = self.verify_trailers(&flash, 0, BOOT_MAGIC_GOOD,
