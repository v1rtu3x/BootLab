+                                                           BOOT_FLAG_UNSET, BOOT_FLAG_UNSET);
+        if !primary_image_valid {
+            warn!("Primary slot does not contain expected new image at fault {}", fault_index);
+        }
+        if !secondary_image_valid {
+            warn!("Secondary slot does not contain expected old image at fault {}", fault_index);
+        }
+        if !primary_trailer_valid {
+            warn!("Primary slot trailer mismatch at fault {}", fault_index);
+        }
+        if !secondary_trailer_valid {
+            warn!("Secondary slot trailer mismatch at fault {}", fault_index);
+        }
+        let recovery_ok = primary_image_valid && secondary_image_valid &&
+                          primary_trailer_valid && secondary_trailer_valid;
+        FaultCampaignObservation {
+            recovery_ok,
+            interruption_reached,
+            operation_count,
+            primary_image_valid,
+            secondary_image_valid,
+            primary_trailer_valid,
+            secondary_trailer_valid,
+        }
+    }
