+    /// Run an upgrade, optionally stopping after `fault_index` flash operations to
+    /// simulate a power-loss reset, then resuming. Returns the final flash state
+    /// and the total operation count. Public entry point for fault campaigns.
+    pub fn run_upgrade_with_fault_at(&self, fault_index: i32, permanent: bool) -> (SimMultiFlash, i32) {
+        self.try_upgrade(Some(fault_index), permanent)
+    }
+
+    /// Public fault-campaign helper: stop at `fault_index`, resume, and verify
+    /// that the upgrade completed correctly and the final state is consistent.
+    /// Returns `true` if a failure was detected.
+    pub fn run_fault_campaign_check(&self, fault_index: i32) -> bool {
+        let (flash, _count) = self.run_upgrade_with_fault_at(fault_index, true);
+        let mut fails = 0;
+
+        if !self.verify_images(&flash, 0, 1) {
+            warn!("Primary slot does not contain expected new image at fault {}", fault_index);
+            fails += 1;
+        }
+        if self.is_swap_upgrade() && !self.verify_images(&flash, 1, 0) {
+            warn!("Secondary slot does not contain expected old image at fault {}", fault_index);
+            fails += 1;
+        }
+        if !self.verify_trailers(&flash, 0, BOOT_MAGIC_GOOD,
+                                 BOOT_FLAG_SET, BOOT_FLAG_SET) {
+            warn!("Primary slot trailer mismatch at fault {}", fault_index);
+            fails += 1;
+        }
+        if !self.verify_trailers(&flash, 1, BOOT_MAGIC_UNSET,
+                                 BOOT_FLAG_UNSET, BOOT_FLAG_UNSET) {
+            warn!("Secondary slot trailer mismatch at fault {}", fault_index);
+            fails += 1;
+        }
+
+        fails > 0
+    }
+
