+// Copyright (c) 2026 BootLab contributors
+//
+// SPDX-License-Identifier: Apache-2.0
+
+//! Deterministic fault-campaign tests for the BootLab lab.
+//!
+//! These tests extend the upstream simulator with explicit, reproducible
+//! interruption points. The Python harness selects the fault index via the
+//! `FAULT_INDEX` environment variable.
+
+use bootsim::{ImagesBuilder, NO_DEPS, testlog};
+
+/// Probe the total number of flash operations for a standard upgrade.
+#[test]
+fn fault_campaign_probe() {
+    testlog::setup();
+
+    ImagesBuilder::each_device(|r| {
+        let images = r.make_image(&NO_DEPS, true);
+        let total = images.run_basic_upgrade(true)
+            .expect("upgrade must succeed to establish fault-campaign baseline");
+        println!("FAULT_PROBE total_ops={}", total);
+    });
+}
+
+/// Run a single upgrade with an interruption at `FAULT_INDEX`, then resume and
+/// verify that the upgrade converges to a consistent state.
+#[test]
+fn fault_campaign_upgrade() {
+    testlog::setup();
+
+    let fault_index: i32 = std::env::var("FAULT_INDEX")
+        .expect("FAULT_INDEX environment variable must be set")
+        .parse()
+        .expect("FAULT_INDEX must be an integer");
+
+    ImagesBuilder::each_device(|r| {
+        let images = r.make_image(&NO_DEPS, true);
+        let failed = images.run_fault_campaign_check(fault_index);
+        println!("FAULT_RESULT index={} failed={}", fault_index, failed);
+        assert!(!failed, "fault_campaign_upgrade failed at index {}", fault_index);
+    });
+}
